#!/bin/sh
# Starts the local Redis instance for jobs that need one. Not every
# project's test suite touches Redis, so this is opt-in like
# start-mysql — jobs that never call it never pay for it.
set -e

# Log to a file so the memory overcommit warning (the kernel setting
# belongs to the CI host and can't be changed from the container) doesn't
# clutter job output. The log is printed if Redis doesn't come up.
log=/tmp/redis-server.log
redis-server --daemonize yes --bind 127.0.0.1 --logfile "$log"

for _ in $(seq 1 30); do
  if redis-cli -h 127.0.0.1 ping >/dev/null 2>&1; then
    break
  fi
  sleep 0.5
done
redis-cli -h 127.0.0.1 ping || { cat "$log" >&2; exit 1; }
